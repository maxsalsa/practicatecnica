{
  "name": "practicatecnica",
  "version": "11.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:http": "node --import tsx scripts/test-http.ts",
    "content:validate": "node --import tsx scripts/content-validate.ts",
    "content:import": "node --import tsx scripts/content-import.ts",
    "setup:check": "node --import tsx scripts/setup-check.ts",
    "setup:project": "node --import tsx scripts/setup-project.ts",
    "setup:backend": "node --import tsx scripts/install-backend.ts",
    "db:migrate": "node --import tsx scripts/db-migrate.ts",
    "owner:bootstrap": "node --import tsx scripts/owner-bootstrap.ts",
    "mail:deploy": "node --import tsx scripts/mail-deploy.ts",
    "mail:configure": "node --import tsx scripts/mail-configure.ts",
    "mail:smoke": "node --import tsx scripts/mail-smoke.ts",
    "backup": "node --import tsx scripts/backup.ts",
    "backup:run": "node --import tsx scripts/backup.ts",
    "restore:verify": "node --import tsx scripts/restore-verify.ts",
    "release:check": "node --import tsx scripts/release-check.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.1",
    "lucide-react": "1.47.0",
    "next": "16.3.6",
    "pdf-lib": "1.17.1",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "pnpm": "12.6.0",
    "supabase": "2.117.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
