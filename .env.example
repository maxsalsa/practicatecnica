# Copy to .env.local. NEVER commit that file. Use a new Supabase project.
APP_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SERVER_SECRET_KEY
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_WEBHOOK_SECRET=YOUR_WEBHOOK_SIGNING_SECRET
MAIL_FROM=PracTICAtecnica.com <acceso@notificaciones.practicatecnica.com>
MAIL_REPLY_TO=maxi.salsa@gmail.com
# Generate each independently: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MAIL_ENCRYPTION_KEY=YOUR_32_BYTE_BASE64_KEY
MAIL_WORKER_SECRET=YOUR_RANDOM_WORKER_SECRET
# Operational only: private terminal/CI, not browser or Vercel runtime.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DATABASE_PASSWORD@YOUR_POOLER_HOST:5432/postgres
SUPABASE_ACCESS_TOKEN=YOUR_MANAGEMENT_ACCESS_TOKEN
BACKUP_ENCRYPTION_KEY=YOUR_SEPARATE_32_BYTE_BASE64_BACKUP_KEY
